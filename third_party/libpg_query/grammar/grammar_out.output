Grammar

    0 $accept: stmtblock $end

    1 stmtblock: stmtmulti

    2 stmtmulti: stmtmulti ';' stmt
    3          | stmt

    4 stmt: AlterObjectSchemaStmt
    5     | AlterSeqStmt
    6     | AlterTableStmt
    7     | AnalyzeStmt
    8     | CallStmt
    9     | CheckPointStmt
   10     | CopyStmt
   11     | CreateAsStmt
   12     | CreateEnumStmt
   13     | CreateFunctionStmt
   14     | CreateSchemaStmt
   15     | CreateSeqStmt
   16     | CreateStmt
   17     | DeallocateStmt
   18     | DeleteStmt
   19     | DropStmt
   20     | ExecuteStmt
   21     | ExplainStmt
   22     | ExportStmt
   23     | ImportStmt
   24     | IndexStmt
   25     | InsertStmt
   26     | LoadStmt
   27     | PragmaStmt
   28     | PrepareStmt
   29     | RenameStmt
   30     | SelectStmt
   31     | TransactionStmt
   32     | UpdateStmt
   33     | VacuumStmt
   34     | VariableResetStmt
   35     | VariableSetStmt
   36     | VariableShowStmt
   37     | ViewStmt
   38     | /* empty */

   39 DeleteStmt: opt_with_clause DELETE_P FROM relation_expr_opt_alias using_clause where_or_current_clause returning_clause

   40 relation_expr_opt_alias: relation_expr
   41                        | relation_expr ColId
   42                        | relation_expr AS ColId

   43 where_or_current_clause: WHERE a_expr
   44                        | /* empty */

   45 using_clause: USING from_list
   46             | /* empty */

   47 CreateAsStmt: CREATE_P OptTemp TABLE create_as_target AS SelectStmt opt_with_data
   48             | CREATE_P OptTemp TABLE IF_P NOT EXISTS create_as_target AS SelectStmt opt_with_data

   49 opt_with_data: WITH DATA_P
   50              | WITH NO DATA_P
   51              | /* empty */

   52 create_as_target: qualified_name opt_column_list OptWith OnCommitOption

   53 ViewStmt: CREATE_P OptTemp VIEW qualified_name opt_column_list opt_reloptions AS SelectStmt opt_check_option
   54         | CREATE_P OR REPLACE OptTemp VIEW qualified_name opt_column_list opt_reloptions AS SelectStmt opt_check_option
   55         | CREATE_P OptTemp RECURSIVE VIEW qualified_name '(' columnList ')' opt_reloptions AS SelectStmt opt_check_option
   56         | CREATE_P OR REPLACE OptTemp RECURSIVE VIEW qualified_name '(' columnList ')' opt_reloptions AS SelectStmt opt_check_option

   57 opt_check_option: WITH CHECK_P OPTION
   58                 | WITH CASCADED CHECK_P OPTION
   59                 | WITH LOCAL CHECK_P OPTION
   60                 | /* empty */

   61 PrepareStmt: PREPARE name prep_type_clause AS PreparableStmt

   62 prep_type_clause: '(' type_list ')'
   63                 | /* empty */

   64 PreparableStmt: SelectStmt
   65               | InsertStmt
   66               | UpdateStmt
   67               | DeleteStmt

   68 SelectStmt: select_no_parens
   69           | select_with_parens

   70 select_with_parens: '(' select_no_parens ')'
   71                   | '(' select_with_parens ')'

   72 select_no_parens: simple_select
   73                 | select_clause sort_clause
   74                 | select_clause opt_sort_clause for_locking_clause opt_select_limit
   75                 | select_clause opt_sort_clause select_limit opt_for_locking_clause
   76                 | with_clause select_clause
   77                 | with_clause select_clause sort_clause
   78                 | with_clause select_clause opt_sort_clause for_locking_clause opt_select_limit
   79                 | with_clause select_clause opt_sort_clause select_limit opt_for_locking_clause

   80 select_clause: simple_select
   81              | select_with_parens

   82 simple_select: SELECT opt_all_clause opt_target_list into_clause from_clause where_clause group_clause having_clause window_clause qualify_clause sample_clause
   83              | SELECT distinct_clause target_list into_clause from_clause where_clause group_clause having_clause window_clause qualify_clause sample_clause
   84              | values_clause
   85              | TABLE relation_expr
   86              | select_clause UNION all_or_distinct select_clause
   87              | select_clause INTERSECT all_or_distinct select_clause
   88              | select_clause EXCEPT all_or_distinct select_clause

   89 with_clause: WITH cte_list
   90            | WITH_LA cte_list
   91            | WITH RECURSIVE cte_list

   92 cte_list: common_table_expr
   93         | cte_list ',' common_table_expr

   94 common_table_expr: name opt_name_list AS '(' PreparableStmt ')'

   95 into_clause: INTO OptTempTableName
   96            | /* empty */

   97 OptTempTableName: TEMPORARY opt_table qualified_name
   98                 | TEMP opt_table qualified_name
   99                 | LOCAL TEMPORARY opt_table qualified_name
  100                 | LOCAL TEMP opt_table qualified_name
  101                 | GLOBAL TEMPORARY opt_table qualified_name
  102                 | GLOBAL TEMP opt_table qualified_name
  103                 | UNLOGGED opt_table qualified_name
  104                 | TABLE qualified_name
  105                 | qualified_name

  106 opt_table: TABLE
  107          | /* empty */

  108 all_or_distinct: ALL
  109                | DISTINCT
  110                | /* empty */

  111 distinct_clause: DISTINCT
  112                | DISTINCT ON '(' expr_list ')'

  113 opt_all_clause: ALL
  114               | /* empty */

  115 opt_ignore_nulls: IGNORE_P NULLS_P
  116                 | RESPECT_P NULLS_P
  117                 | /* empty */

  118 opt_sort_clause: sort_clause
  119                | /* empty */

  120 sort_clause: ORDER BY sortby_list
  121            | ORDER BY ALL opt_asc_desc opt_nulls_order
  122            | ORDER BY '*' opt_asc_desc opt_nulls_order

  123 sortby_list: sortby
  124            | sortby_list ',' sortby

  125 sortby: a_expr USING qual_all_Op opt_nulls_order
  126       | a_expr opt_asc_desc opt_nulls_order

  127 opt_asc_desc: ASC_P
  128             | DESC_P
  129             | /* empty */

  130 opt_nulls_order: NULLS_LA FIRST_P
  131                | NULLS_LA LAST_P
  132                | /* empty */

  133 select_limit: limit_clause offset_clause
  134             | offset_clause limit_clause
  135             | limit_clause
  136             | offset_clause

  137 opt_select_limit: select_limit
  138                 | /* empty */

  139 limit_clause: LIMIT select_limit_value
  140             | LIMIT select_limit_value ',' select_offset_value
  141             | FETCH first_or_next select_fetch_first_value row_or_rows ONLY
  142             | FETCH first_or_next row_or_rows ONLY

  143 offset_clause: OFFSET select_offset_value
  144              | OFFSET select_fetch_first_value row_or_rows

  145 sample_count: FCONST '%'
  146             | ICONST '%'
  147             | FCONST PERCENT
  148             | ICONST PERCENT
  149             | ICONST
  150             | ICONST ROWS

  151 sample_clause: USING SAMPLE tablesample_entry
  152              | /* empty */

  153 opt_sample_func: ColId
  154                | /* empty */

  155 tablesample_entry: opt_sample_func '(' sample_count ')' opt_repeatable_clause
  156                  | sample_count
  157                  | sample_count '(' ColId ')'
  158                  | sample_count '(' ColId ',' ICONST ')'

  159 tablesample_clause: TABLESAMPLE tablesample_entry

  160 opt_tablesample_clause: tablesample_clause
  161                       | /* empty */

  162 opt_repeatable_clause: REPEATABLE '(' ICONST ')'
  163                      | /* empty */

  164 select_limit_value: a_expr
  165                   | ALL
  166                   | a_expr '%'
  167                   | FCONST PERCENT
  168                   | ICONST PERCENT

  169 select_offset_value: a_expr

  170 select_fetch_first_value: c_expr
  171                         | '+' I_or_F_const
  172                         | '-' I_or_F_const

  173 I_or_F_const: Iconst
  174             | FCONST

  175 row_or_rows: ROW
  176            | ROWS

  177 first_or_next: FIRST_P
  178              | NEXT

  179 group_clause: GROUP_P BY group_by_list
  180             | GROUP_P BY ALL
  181             | GROUP_P BY '*'
  182             | /* empty */

  183 group_by_list: group_by_item
  184              | group_by_list ',' group_by_item

  185 group_by_item: a_expr
  186              | empty_grouping_set
  187              | cube_clause
  188              | rollup_clause
  189              | grouping_sets_clause

  190 empty_grouping_set: '(' ')'

  191 rollup_clause: ROLLUP '(' expr_list ')'

  192 cube_clause: CUBE '(' expr_list ')'

  193 grouping_sets_clause: GROUPING SETS '(' group_by_list ')'

  194 grouping_or_grouping_id: GROUPING
  195                        | GROUPING_ID

  196 having_clause: HAVING a_expr
  197              | /* empty */

  198 qualify_clause: QUALIFY a_expr
  199               | /* empty */

  200 for_locking_clause: for_locking_items
  201                   | FOR READ_P ONLY

  202 opt_for_locking_clause: for_locking_clause
  203                       | /* empty */

  204 for_locking_items: for_locking_item
  205                  | for_locking_items for_locking_item

  206 for_locking_item: for_locking_strength locked_rels_list opt_nowait_or_skip

  207 for_locking_strength: FOR UPDATE
  208                     | FOR NO KEY UPDATE
  209                     | FOR SHARE
  210                     | FOR KEY SHARE

  211 locked_rels_list: OF qualified_name_list
  212                 | /* empty */

  213 opt_nowait_or_skip: NOWAIT
  214                   | SKIP LOCKED
  215                   | /* empty */

  216 values_clause: VALUES '(' expr_list ')'
  217              | values_clause ',' '(' expr_list ')'

  218 from_clause: FROM from_list
  219            | /* empty */

  220 from_list: table_ref
  221          | from_list ',' table_ref

  222 table_ref: relation_expr opt_alias_clause opt_tablesample_clause
  223          | func_table func_alias_clause opt_tablesample_clause
  224          | LATERAL_P func_table func_alias_clause
  225          | select_with_parens opt_alias_clause opt_tablesample_clause
  226          | LATERAL_P select_with_parens opt_alias_clause
  227          | joined_table
  228          | '(' joined_table ')' alias_clause

  229 joined_table: '(' joined_table ')'
  230             | table_ref CROSS JOIN table_ref
  231             | table_ref join_type JOIN table_ref join_qual
  232             | table_ref JOIN table_ref join_qual
  233             | table_ref NATURAL join_type JOIN table_ref
  234             | table_ref NATURAL JOIN table_ref

  235 alias_clause: AS ColId '(' name_list ')'
  236             | AS ColIdOrString
  237             | ColId '(' name_list ')'
  238             | ColId

  239 opt_alias_clause: alias_clause
  240                 | /* empty */

  241 func_alias_clause: alias_clause
  242                  | AS '(' TableFuncElementList ')'
  243                  | AS ColId '(' TableFuncElementList ')'
  244                  | ColId '(' TableFuncElementList ')'
  245                  | /* empty */

  246 join_type: FULL join_outer
  247          | LEFT join_outer
  248          | RIGHT join_outer
  249          | INNER_P

  250 join_outer: OUTER_P
  251           | /* empty */

  252 join_qual: USING '(' name_list ')'
  253          | ON a_expr

  254 relation_expr: qualified_name
  255              | qualified_name '*'
  256              | ONLY qualified_name
  257              | ONLY '(' qualified_name ')'

  258 func_table: func_expr_windowless opt_ordinality
  259           | ROWS FROM '(' rowsfrom_list ')' opt_ordinality

  260 rowsfrom_item: func_expr_windowless opt_col_def_list

  261 rowsfrom_list: rowsfrom_item
  262              | rowsfrom_list ',' rowsfrom_item

  263 opt_col_def_list: AS '(' TableFuncElementList ')'
  264                 | /* empty */

  265 opt_ordinality: WITH_LA ORDINALITY
  266               | /* empty */

  267 where_clause: WHERE a_expr
  268             | /* empty */

  269 TableFuncElementList: TableFuncElement
  270                     | TableFuncElementList ',' TableFuncElement

  271 TableFuncElement: ColId Typename opt_collate_clause

  272 opt_collate_clause: COLLATE any_name
  273                   | /* empty */

  274 colid_type_list: ColId Typename
  275                | colid_type_list ',' ColId Typename

  276 RowOrStruct: ROW
  277            | STRUCT

  278 Typename: SimpleTypename opt_array_bounds
  279         | SETOF SimpleTypename opt_array_bounds
  280         | SimpleTypename ARRAY '[' Iconst ']'
  281         | SETOF SimpleTypename ARRAY '[' Iconst ']'
  282         | SimpleTypename ARRAY
  283         | SETOF SimpleTypename ARRAY
  284         | RowOrStruct '(' colid_type_list ')' opt_array_bounds
  285         | MAP '(' type_list ')' opt_array_bounds

  286 opt_array_bounds: opt_array_bounds '[' ']'
  287                 | opt_array_bounds '[' Iconst ']'
  288                 | /* empty */

  289 SimpleTypename: GenericType
  290               | Numeric
  291               | Bit
  292               | Character
  293               | ConstDatetime
  294               | ConstInterval opt_interval
  295               | ConstInterval '(' Iconst ')'

  296 ConstTypename: Numeric
  297              | ConstBit
  298              | ConstCharacter
  299              | ConstDatetime

  300 GenericType: type_name_token opt_type_modifiers

  301 opt_type_modifiers: '(' expr_list ')'
  302                   | /* empty */

  303 Numeric: INT_P
  304        | INTEGER
  305        | SMALLINT
  306        | BIGINT
  307        | REAL
  308        | FLOAT_P opt_float
  309        | DOUBLE_P PRECISION
  310        | DECIMAL_P opt_type_modifiers
  311        | DEC opt_type_modifiers
  312        | NUMERIC opt_type_modifiers
